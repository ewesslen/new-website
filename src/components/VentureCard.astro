---
import type { Venture } from '../data/site';

interface Props {
  venture: Venture;
}

const { venture } = Astro.props;
const links = venture.links.filter((l) => l.url);
---

<article class="card" data-accent={venture.slug}>
  <p class="kicker">{venture.kicker}</p>
  <div class="card-title">
    <h3>{venture.name}</h3>
    {venture.status && <p class="status">{venture.status}</p>}
  </div>
  <p>{venture.description}</p>
  {
    links.length > 0 && (
      <ul class="card-links">
        {links.map((link) => (
          <li>
            <a href={link.url}>{link.label}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

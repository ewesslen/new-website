---
/**
 * IsoCubesBackground — ambient, autonomous isometric-cube field.
 *
 * A fixed, full-viewport Canvas 2D layer behind all content (z-index -1,
 * pointer-events none, aria-hidden). Cubes fly in from beyond the edge of
 * the screen along the isometric axes, settle onto a destination cell —
 * stacking into small towers around a configurable focal point — rest
 * there, then fly back out again. The whole field sways on a slow orbit.
 * Three canvas tiers give the depth: far tiers are smaller, fainter,
 * lower-resolution, and softened by *static* CSS blurs — the compositor
 * pays for depth-of-field once, never per cube.
 *
 * Every journey is one continuous glide: a long approach along one
 * horizontal iso axis at cruise altitude, then a vertical settle onto the
 * destination (reversed on the way out). Duration and easing are drawn
 * fresh per trip, so speed and acceleration never repeat.
 *
 * Cubes can never pass through one another. Planning a trip samples its
 * whole trajectory and claims, for every lattice cell the cube will
 * overlap, the exact time window it is there; a trip is only dispatched
 * if none of those windows collide with a claim already held. Since only
 * one coordinate varies at a time, "never sharing a cell at the same
 * instant" is equivalent to staying a full cell apart — cubes may touch
 * faces but never interpenetrate. A blocked plan is simply not dispatched
 * and is retried with another approach axis or altitude, so nothing ever
 * visibly stalls.
 *
 * Every pixel derives from `baseColor` (default: the theme ink via
 * currentColor). Face shades, edges, and grain are alpha steps of that one
 * color; light/dark polarity is read from the page background so the top
 * face always renders lightest, on either theme.
 *
 * Honors the site's `data-motion` toggle where present (falling back to
 * `prefers-reduced-motion` alone) — motion off renders a single static,
 * fully-assembled composition. Pauses when the tab is hidden or the
 * element leaves the viewport.
 *
 * Mount once, first thing inside <body> (see Base.astro):
 *
 *   <IsoCubesBackground />
 *
 * or tuned:
 *
 *   <IsoCubesBackground intensity={0.7} focal={{ x: 0.5, y: 0.5 }} />
 */
interface Props {
  /** Any CSS color; the entire field derives from it. Default: theme ink. */
  baseColor?: string;
  /** 0..1 — overall visual strength (the field's opacity ceiling). */
  intensity?: number;
  /** Cube-count multiplier: 1 ≈ 70 cubes on a 1440×900 viewport, hard-capped. */
  density?: number;
  /** Focal point the field clusters around, as viewport fractions. */
  focal?: { x: number; y: number };
  /** Cluster tightness — falloff radius as a fraction of min(vw, vh). */
  focalRadius?: number;
  /** 0..1 — how tightly destinations concentrate on the focal point. */
  focalPull?: number;
  /** Global speed multiplier for every motion. */
  speed?: number;
  /** 0..1 — faint film-grain strength (0 disables). */
  grain?: number;
}

const {
  baseColor = 'var(--bg-accent, currentColor)',
  intensity = 0.5,
  density = 1,
  focal = { x: 0.7, y: 0.36 },
  focalRadius = 0.42,
  focalPull = 0.6,
  speed = 1,
  grain = 0.5,
} = Astro.props;

const config = { density, focal, focalRadius, focalPull, speed, grain };
---

<div
  class="iso-cubes"
  aria-hidden="true"
  data-iso-cubes={JSON.stringify(config)}
  style={`color:${baseColor};opacity:${(0.36 * intensity).toFixed(3)};--fx:${(focal.x * 100).toFixed(1)}%;--fy:${(focal.y * 100).toFixed(1)}%;`}
>
  <canvas data-tier="0"></canvas>
  <canvas data-tier="1"></canvas>
  <canvas data-tier="2"></canvas>
  <div class="iso-grain"></div>
</div>

<style>
  .iso-cubes {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    /* Atmospheric falloff: the field breathes around the focal point and
       thins toward the viewport edges instead of ending at a hard frame. */
    -webkit-mask-image: radial-gradient(
      140% 125% at var(--fx) var(--fy),
      #000 28%,
      rgb(0 0 0 / 0.6) 68%,
      rgb(0 0 0 / 0.25) 100%
    );
    mask-image: radial-gradient(
      140% 125% at var(--fx) var(--fy),
      #000 28%,
      rgb(0 0 0 / 0.6) 68%,
      rgb(0 0 0 / 0.25) 100%
    );
  }

  .iso-cubes canvas,
  .iso-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0; /* revealed by script after the first frame */
    transition: opacity 700ms ease;
  }

  /* Depth of field as static compositor filters — no per-cube canvas blur.
     Far tiers also render at reduced backing resolution (see TIERS). */
  canvas[data-tier='0'] {
    filter: blur(2.1px);
  }
  canvas[data-tier='1'] {
    filter: blur(0.7px);
  }

  .iso-grain {
    background-repeat: repeat;
  }

  @media (prefers-reduced-motion: reduce) {
    .iso-cubes canvas,
    .iso-grain {
      transition: none;
    }
  }
</style>

<script>
  /* True isometric axes (30°): every cube shares them — no per-cube
     rotation. A cube is one pre-rendered sprite per tier, stamped many
     times per frame. */
  const ISO_X = Math.cos(Math.PI / 6);
  const ISO_Y = Math.sin(Math.PI / 6);

  /* Depth tiers, far → near. Blur and tier opacity live in CSS; `res`
     drops far-tier backing resolution (blurred anyway), `flatten`
     compresses face contrast with distance, `spread` widens the far
     cluster so the parallax reads as one deep field, and `parallax`
     scales both the shared orbit and travel speed — near sways and moves
     faster than far. */
  const TIERS = [
    { size: 13, share: 0.42, opacity: 0.5, parallax: 0.35, res: 0.6, flatten: 0.45, spread: 1.3 },
    { size: 21, share: 0.34, opacity: 0.75, parallax: 0.65, res: 0.85, flatten: 0.2, spread: 1.05 },
    { size: 33, share: 0.24, opacity: 1, parallax: 1, res: 1, flatten: 0, spread: 0.82 },
  ];

  const PARKED = 0;
  const INBOUND = 1;
  const OUTBOUND = 2;
  const WAITING = 3; // offscreen, holding nothing, awaiting dispatch

  /* Parked cubes live on levels 0..3; travel happens in lanes above them,
     so long approaches never have to thread the resting composition. */
  const MAX_PARK_Z = 3;
  const CRUISE_LO = 4;
  const CRUISE_HI = 6;

  const DIRS: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];

  /* Arrivals decelerate into place, departures accelerate away, and both
     draw from a few shapes so no two trips share a velocity curve. */
  const ARRIVE_EASES = [
    (t: number) => 1 - Math.pow(1 - t, 3),
    (t: number) => 1 - Math.pow(1 - t, 4),
    (t: number) => 1 - Math.pow(1 - t, 2.2),
    (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2),
  ];
  const DEPART_EASES = [
    (t: number) => t * t,
    (t: number) => t * t * t,
    (t: number) => Math.pow(t, 2.4),
    (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2),
  ];

  interface Config {
    density: number;
    focal: { x: number; y: number };
    focalRadius: number;
    focalPull: number;
    speed: number;
    grain: number;
  }

  interface Point {
    x: number;
    y: number;
    z: number;
  }

  interface Cube {
    state: number;
    x: number;
    y: number;
    z: number; // parked cell (meaningful while PARKED)
    px: number;
    py: number;
    pz: number; // render position
    active: boolean; // false only while WAITING offscreen
    path: Point[] | null;
    segLen: number[];
    total: number;
    /* Trip progress is read from the shared clock rather than accumulated
       per cube, so a cube can never drift out of step with the schedule
       its cell reservations were computed against. */
    startT: number;
    dur: number;
    ease: (t: number) => number;
    keys: string[]; // cells this cube currently holds claims on
    site: Site | null;
    level: number;
    dwell: number;
  }

  interface Site {
    gx: number;
    gy: number;
    base: number;
    cap: number;
    stack: Cube[]; // parked cubes plus inbound cubes that already claimed a level
  }

  interface Claim {
    t0: number;
    t1: number;
    c: Cube;
  }

  interface Sprite {
    canvas: HTMLCanvasElement;
    w: number;
    h: number;
    ox: number;
    oy: number;
  }

  interface Tier {
    cfg: (typeof TIERS)[number];
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    scale: number;
    sprite: Sprite;
    cubes: Cube[];
    sites: Site[];
    res: Map<string, Claim[]>; // cell → time windows during which it is occupied
    flightCap: number;
    schedT: number;
    pruneT: number;
  }

  interface Palette {
    r: number;
    g: number;
    b: number;
    a: number;
    faces: { top: number; left: number; right: number };
    edge: number;
  }

  const rand = Math.random;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  /* Box–Muller; 1-rand() keeps log() off zero */
  const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
  const pick = <T,>(arr: T[]): T => arr[Math.floor(rand() * arr.length)]!;

  /* Normalize any CSS color through a 1×1 canvas — handles rgb(), lab(),
     color-mix() results, keywords, everything getComputedStyle can emit. */
  const probe = document.createElement('canvas');
  probe.width = probe.height = 1;
  const probeCtx = probe.getContext('2d', { willReadFrequently: true });

  function parseColor(str: string): [number, number, number, number] {
    if (!probeCtx) return [128, 128, 128, 1];
    probeCtx.clearRect(0, 0, 1, 1);
    probeCtx.fillStyle = '#000';
    probeCtx.fillStyle = str;
    probeCtx.fillRect(0, 0, 1, 1);
    const d = probeCtx.getImageData(0, 0, 1, 1).data;
    return [d[0]!, d[1]!, d[2]!, d[3]! / 255];
  }

  const luminance = (c: [number, number, number, number]) =>
    0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];

  function resolveBackground(): [number, number, number, number] {
    for (const el of [document.body, document.documentElement]) {
      const c = parseColor(getComputedStyle(el).backgroundColor);
      if (c[3] > 0.02) return c;
    }
    return matchMedia('(prefers-color-scheme: dark)').matches
      ? [0, 0, 0, 1]
      : [255, 255, 255, 1];
  }

  function computePalette(el: HTMLElement): Palette {
    const base = parseColor(getComputedStyle(el).color);
    const lightInk = luminance(base) > luminance(resolveBackground());
    /* The top face must read lightest against the page: with a light ink
       on a dark page that means the most ink (highest alpha); with a dark
       ink on a light page, the least. Left stays brighter than right —
       one consistent light source from the upper left. */
    const faces = lightInk
      ? { top: 0.92, left: 0.5, right: 0.3 }
      : { top: 0.26, left: 0.5, right: 0.78 };
    return { r: base[0], g: base[1], b: base[2], a: base[3], faces, edge: 0.85 };
  }

  function shade(pal: Palette, alpha: number): string {
    return `rgba(${pal.r},${pal.g},${pal.b},${(alpha * pal.a).toFixed(3)})`;
  }

  /* One cube, three faces + hairline edges, baked once per tier. `flatten`
     pulls the face alphas toward their mean — distant cubes lose contrast
     the way real atmosphere takes it. */
  function makeSprite(S: number, scale: number, pal: Palette, flatten: number): Sprite {
    const X = ISO_X * S;
    const Y = ISO_Y * S;
    const pad = 2;
    const w = 2 * X + pad * 2;
    const h = 2 * S + pad * 2;
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.ceil(w * scale));
    canvas.height = Math.max(1, Math.ceil(h * scale));
    const ctx = canvas.getContext('2d');
    const ox = pad + X;
    const oy = h - pad;
    if (!ctx) return { canvas, w, h, ox, oy };
    ctx.scale(scale, scale);
    ctx.translate(ox, oy); // origin = bottom-front vertex
    const mean = (pal.faces.top + pal.faces.left + pal.faces.right) / 3;
    const soften = (a: number) => a + (mean - a) * flatten;
    ctx.lineWidth = 1;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = shade(pal, pal.edge * (1 - flatten * 0.7));
    const face = (pts: [number, number][], alpha: number) => {
      ctx.beginPath();
      ctx.moveTo(pts[0]![0], pts[0]![1]);
      for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i]![0], pts[i]![1]);
      ctx.closePath();
      ctx.fillStyle = shade(pal, soften(alpha));
      ctx.fill();
      ctx.stroke();
    };
    face([[0, -S], [X, -Y - S], [0, -2 * Y - S], [-X, -Y - S]], pal.faces.top);
    face([[0, 0], [-X, -Y], [-X, -Y - S], [0, -S]], pal.faces.left);
    face([[0, 0], [X, -Y], [X, -Y - S], [0, -S]], pal.faces.right);
    return { canvas, w, h, ox, oy };
  }

  /* Cube silhouette (hexagon), used to punch a hole before stamping the
     translucent sprite: back cubes never bleed through front ones, which
     is what makes the painter's-algorithm stacking actually read. */
  function hexPath(ctx: CanvasRenderingContext2D, x: number, y: number, S: number): void {
    const X = ISO_X * S;
    const Y = ISO_Y * S;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + X, y - Y);
    ctx.lineTo(x + X, y - Y - S);
    ctx.lineTo(x, y - 2 * Y - S);
    ctx.lineTo(x - X, y - Y - S);
    ctx.lineTo(x - X, y - Y);
    ctx.closePath();
  }

  function setup(container: HTMLElement): void {
    const cfg: Config = {
      density: 1,
      focal: { x: 0.7, y: 0.36 },
      focalRadius: 0.42,
      focalPull: 0.6,
      speed: 1,
      grain: 0.5,
      ...(JSON.parse(container.dataset.isoCubes || '{}') as Partial<Config>),
    };
    const canvases = Array.from(container.querySelectorAll('canvas'));
    const grainEl = container.querySelector<HTMLElement>('.iso-grain');
    if (canvases.length < TIERS.length) return;

    let W = 0;
    let H = 0;
    let palette: Palette = computePalette(container);
    let tiers: Tier[] = [];
    let simT = 0; // reservation clock, seconds of simulated time
    let orbT = rand() * 70; // start mid-orbit: nothing to sync a loop point to
    let raf = 0;
    let last = 0;
    let intersecting = true;
    let revealed = false;

    /* World mapping: screen = center + iso(world), so world coords survive
       gentle resizes and the orbit is a pure render-time offset. */
    const toScreenX = (t: Tier, gx: number, gy: number) => W / 2 + (gx - gy) * ISO_X * t.cfg.size;
    const toScreenY = (t: Tier, gx: number, gy: number, gz: number) =>
      H / 2 + (gx + gy) * ISO_Y * t.cfg.size - gz * t.cfg.size;
    const toWorld = (t: Tier, px: number, py: number) => {
      const u = (px - W / 2) / (ISO_X * t.cfg.size);
      const v = (py - H / 2) / (ISO_Y * t.cfg.size);
      return { gx: (v + u) / 2, gy: (v - u) / 2 };
    };

    /* Gaussian sample around the focal point — the density falloff. σ is
       half the falloff radius scaled by focalPull, so destinations cluster
       tightly or loosely without ever forming a hard boundary. */
    const sampleHome = (t: Tier) => {
      const tighten = 1.35 - 0.7 * cfg.focalPull;
      const R = cfg.focalRadius * Math.min(W, H) * 0.5 * t.cfg.spread * tighten;
      return toWorld(t, cfg.focal.x * W + gauss() * R, cfg.focal.y * H + gauss() * R * 0.8);
    };

    const cellKey = (x: number, y: number, z: number) => `${x},${y},${z}`;

    /* ---------- Trip geometry ---------- */

    function segments(path: Point[]): { segLen: number[]; total: number } {
      const segLen: number[] = [];
      let total = 0;
      for (let i = 1; i < path.length; i++) {
        const a = path[i - 1]!;
        const b = path[i]!;
        const len = Math.abs(b.x - a.x) + Math.abs(b.y - a.y) + Math.abs(b.z - a.z);
        segLen.push(len);
        total += len;
      }
      return { segLen, total };
    }

    /* Position at distance d along the poly-line. Fixed coordinates come
       out bit-exact (a + 0 * f), which keeps cell math free of drift. */
    function posAt(path: Point[], segLen: number[], d: number): Point {
      let rem = clamp(d, 0, Infinity);
      for (let i = 0; i < segLen.length; i++) {
        const len = segLen[i]!;
        if (rem <= len || i === segLen.length - 1) {
          const a = path[i]!;
          const b = path[i + 1]!;
          const f = len > 0 ? clamp(rem / len, 0, 1) : 1;
          return {
            x: a.x + (b.x - a.x) * f,
            y: a.y + (b.y - a.y) * f,
            z: a.z + (b.z - a.z) * f,
          };
        }
        rem -= len;
      }
      return path[path.length - 1]!;
    }

    /* Easings are monotone, so bisection inverts them exactly enough to
       turn "distance along the path" back into "when". */
    function inverseEase(ease: (t: number) => number, p: number): number {
      let lo = 0;
      let hi = 1;
      for (let i = 0; i < 30; i++) {
        const mid = (lo + hi) / 2;
        if (ease(mid) < p) lo = mid;
        else hi = mid;
      }
      return (lo + hi) / 2;
    }

    /* The exact time window during which the cube overlaps each cell it
       passes through. A unit cube centred at v covers every integer
       strictly within 1 of it, so along a segment whose varying
       coordinate runs v0 → v1, cell c is occupied precisely while v is
       inside (c-1, c+1) — two boundaries, converted to distance, then to
       time through the easing's inverse. Solving it rather than sampling
       it matters: eased motion is several times faster than average over
       part of a long path, where any fixed sampling rate can step clean
       over a cell and leave it unclaimed. */
    function claimWindows(
      path: Point[],
      segLen: number[],
      total: number,
      dur: number,
      ease: (t: number) => number,
      startT: number
    ): Map<string, [number, number]> {
      const out = new Map<string, [number, number]>();
      const timeAt = (d: number) => startT + dur * inverseEase(ease, clamp(d / total, 0, 1));
      let base = 0;
      for (let i = 0; i < segLen.length; i++) {
        const a = path[i]!;
        const b = path[i + 1]!;
        const len = segLen[i]!;
        if (len <= 0) continue;
        const axis: 'x' | 'y' | 'z' = b.x !== a.x ? 'x' : b.y !== a.y ? 'y' : 'z';
        const v0 = a[axis];
        const v1 = b[axis];
        const lo = Math.min(v0, v1);
        const hi = Math.max(v0, v1);
        for (let c = Math.ceil(lo - 1); c <= Math.floor(hi + 1); c++) {
          const vA = Math.max(lo, c - 1);
          const vB = Math.min(hi, c + 1);
          if (vB <= vA) continue; // touching only — never inside the cell
          const sA = Math.abs(vA - v0);
          const sB = Math.abs(vB - v0);
          const t0 = timeAt(base + Math.min(sA, sB));
          const t1 = timeAt(base + Math.max(sA, sB));
          const key = cellKey(
            axis === 'x' ? c : a.x,
            axis === 'y' ? c : a.y,
            axis === 'z' ? c : a.z
          );
          const span = out.get(key);
          if (span) {
            if (t0 < span[0]) span[0] = t0;
            if (t1 > span[1]) span[1] = t1;
          } else {
            out.set(key, [t0, t1]);
          }
        }
        base += len;
      }
      const pad = 0.08; // margin for frame granularity and float slop
      for (const span of out.values()) {
        span[0] -= pad;
        span[1] += pad;
      }
      return out;
    }

    function conflicts(t: Tier, windows: Map<string, [number, number]>, self: Cube): boolean {
      for (const [key, [t0, t1]] of windows) {
        const held = t.res.get(key);
        if (!held) continue;
        for (const r of held) {
          if (r.c !== self && t0 <= r.t1 && r.t0 <= t1) return true;
        }
      }
      return false;
    }

    function dropClaims(t: Tier, c: Cube): void {
      for (const key of c.keys) {
        const held = t.res.get(key);
        if (!held) continue;
        const kept = held.filter((r) => r.c !== c);
        if (kept.length) t.res.set(key, kept);
        else t.res.delete(key);
      }
      c.keys = [];
    }

    function commit(t: Tier, c: Cube, windows: Map<string, [number, number]>): void {
      dropClaims(t, c);
      const keys: string[] = [];
      for (const [key, [t0, t1]] of windows) {
        const held = t.res.get(key) ?? [];
        held.push({ t0, t1, c });
        t.res.set(key, held);
        keys.push(key);
      }
      c.keys = keys;
    }

    function prune(t: Tier): void {
      for (const [key, held] of t.res) {
        const kept = held.filter((r) => r.t1 >= simT);
        if (kept.length) t.res.set(key, kept);
        else t.res.delete(key);
      }
    }

    /* Steps along (dx, dy) from a column until the projected cube clears
       the viewport — where a journey starts, or ends. */
    function offscreenSteps(t: Tier, gx: number, gy: number, z: number, dx: number, dy: number): number {
      const m = t.cfg.size * 2.6 + 30; // covers the orbit sway too
      for (let n = 2; n <= 300; n++) {
        const sx = toScreenX(t, gx + dx * n, gy + dy * n);
        const sy = toScreenY(t, gx + dx * n, gy + dy * n, z);
        if (sx < -m || sx > W + m || sy < -m || sy > H + m) return n + 1 + Math.floor(rand() * 4);
      }
      return 0;
    }

    function screenLength(t: Tier, path: Point[]): number {
      let len = 0;
      for (let i = 1; i < path.length; i++) {
        const a = path[i - 1]!;
        const b = path[i]!;
        len += Math.hypot(
          toScreenX(t, b.x, b.y) - toScreenX(t, a.x, a.y),
          toScreenY(t, b.x, b.y, b.z) - toScreenY(t, a.x, a.y, a.z)
        );
      }
      return len;
    }

    /* Speed varies per trip and with depth: nearer tiers cover more screen
       distance per second, which reads as parallax rather than haste. */
    function tripDuration(t: Tier, path: Point[]): number {
      const pxPerSec = (55 + rand() * 85) * (0.45 + 0.55 * t.cfg.parallax);
      return clamp(screenLength(t, path) / pxPerSec, 4, 40);
    }

    function launch(
      t: Tier,
      c: Cube,
      path: Point[],
      ease: (t: number) => number,
      state: number,
      parkKey: string | null
    ): boolean {
      const { segLen, total } = segments(path);
      if (total <= 0) return false;
      /* Durations are in simulated seconds; the clock already carries
         cfg.speed, so it must not be applied a second time here. */
      const dur = tripDuration(t, path);
      const windows = claimWindows(path, segLen, total, dur, ease, simT);
      /* A cube stays on its destination until it next departs, so that
         cell is held from arrival onward. The open-ended hold has to be
         in place for the conflict *check*, not just the commit: checking
         only the arrival window would let a cube park somewhere another
         cube has already booked a later pass through. */
      if (parkKey) {
        const span = windows.get(parkKey);
        if (span) span[1] = Infinity;
      }
      if (conflicts(t, windows, c)) return false;
      commit(t, c, windows);
      c.path = path;
      c.segLen = segLen;
      c.total = total;
      c.dur = dur;
      c.ease = ease;
      c.startT = simT;
      c.state = state;
      c.active = true;
      const p = posAt(path, segLen, 0);
      c.px = p.x;
      c.py = p.y;
      c.pz = p.z;
      return true;
    }

    /* In: fly from offscreen along one axis at cruise altitude to the
       column, then settle straight down onto the stack top. */
    function planInbound(t: Tier, c: Cube, site: Site, level: number): boolean {
      const gz = site.base + level;
      for (let attempt = 0; attempt < 8; attempt++) {
        const dir = pick(DIRS);
        const cruise = CRUISE_LO + Math.floor(rand() * (CRUISE_HI - CRUISE_LO + 1));
        const n = offscreenSteps(t, site.gx, site.gy, cruise, -dir[0], -dir[1]);
        if (n === 0) continue;
        const path: Point[] = [
          { x: site.gx - dir[0] * n, y: site.gy - dir[1] * n, z: cruise },
          { x: site.gx, y: site.gy, z: cruise },
          { x: site.gx, y: site.gy, z: gz },
        ];
        if (launch(t, c, path, pick(ARRIVE_EASES), INBOUND, cellKey(site.gx, site.gy, gz))) {
          c.site = site;
          c.level = level;
          return true;
        }
      }
      return false;
    }

    /* Out: lift straight up out of the stack, then away along one axis
       until fully offscreen. */
    function planOutbound(t: Tier, c: Cube): boolean {
      const site = c.site;
      if (!site) return false;
      const gz = site.base + c.level;
      for (let attempt = 0; attempt < 8; attempt++) {
        const dir = pick(DIRS);
        const cruise = CRUISE_LO + Math.floor(rand() * (CRUISE_HI - CRUISE_LO + 1));
        const n = offscreenSteps(t, site.gx, site.gy, cruise, dir[0], dir[1]);
        if (n === 0) continue;
        const path: Point[] = [
          { x: site.gx, y: site.gy, z: gz },
          { x: site.gx, y: site.gy, z: cruise },
          { x: site.gx + dir[0] * n, y: site.gy + dir[1] * n, z: cruise },
        ];
        if (launch(t, c, path, pick(DEPART_EASES), OUTBOUND, null)) return true;
      }
      return false;
    }

    const flightsOf = (t: Tier) =>
      t.cubes.reduce((n, c) => n + (c.state === INBOUND || c.state === OUTBOUND ? 1 : 0), 0);

    function finishTrip(t: Tier, c: Cube): void {
      const path = c.path!;
      const end = path[path.length - 1]!;
      c.px = end.x;
      c.py = end.y;
      c.pz = end.z;
      c.path = null;
      if (c.state === INBOUND) {
        c.x = end.x;
        c.y = end.y;
        c.z = end.z;
        c.state = PARKED;
        c.dwell = 90 + rand() * 150; // long rests keep the field calm
      } else {
        if (c.site && c.site.stack.at(-1) === c) c.site.stack.pop();
        c.site = null;
        c.state = WAITING;
        c.active = false;
        c.dwell = 3 + rand() * 12;
        dropClaims(t, c);
      }
    }

    /* Sites are destinations, not physics: towers stack bottom-up from
       z 0, singles float at a fixed level. Validity of any particular
       landing is settled by the reservation check at plan time. */
    function newSite(t: Tier, avoid: Set<string>): Site | null {
      for (let i = 0; i < 12; i++) {
        const p = sampleHome(t);
        const gx = Math.round(p.gx);
        const gy = Math.round(p.gy);
        const key = `${gx},${gy}`;
        if (avoid.has(key)) continue;
        avoid.add(key);
        const tower = rand() < 0.42;
        return {
          gx,
          gy,
          base: tower ? 0 : Math.floor(rand() * (MAX_PARK_Z + 1)),
          cap: tower ? 2 + Math.floor(rand() * 2) : 1,
          stack: [],
        };
      }
      return null;
    }

    const columnKeys = (t: Tier) => new Set(t.sites.map((s) => `${s.gx},${s.gy}`));

    function makeCube(): Cube {
      return {
        state: WAITING,
        x: 0,
        y: 0,
        z: 0,
        px: 0,
        py: 0,
        pz: 0,
        active: false,
        path: null,
        segLen: [],
        total: 0,
        startT: 0,
        dur: 1,
        ease: ARRIVE_EASES[0]!,
        keys: [],
        site: null,
        level: 0,
        dwell: rand() * 8,
      };
    }

    function populate(t: Tier, count: number): void {
      t.cubes = [];
      t.sites = [];
      t.res = new Map();
      const avoid = new Set<string>();
      /* Enough capacity to hold the resting population with slack left
         over, so arrivals always have somewhere to go. */
      const nSites = Math.max(3, Math.round(count / 1.5));
      for (let i = 0; i < nSites; i++) {
        const s = newSite(t, avoid);
        if (s) t.sites.push(s);
      }
      for (let i = 0; i < count; i++) t.cubes.push(makeCube());
      t.flightCap = Math.max(2, Math.round(count * 0.18));

      /* Open on a settled composition: most cubes already parked (this is
         also exactly what reduced motion freezes on), the rest waiting
         offscreen on staggered timers. */
      let placed = 0;
      const target = Math.round(count * 0.82);
      for (const site of t.sites) {
        while (placed < target && site.stack.length < site.cap) {
          const c = t.cubes[placed]!;
          const z = site.base + site.stack.length;
          c.state = PARKED;
          c.active = true;
          c.site = site;
          c.level = site.stack.length;
          c.x = c.px = site.gx;
          c.y = c.py = site.gy;
          c.z = c.pz = z;
          c.dwell = 8 + rand() * 220; // spread first departures over minutes
          const key = cellKey(site.gx, site.gy, z);
          t.res.set(key, [{ t0: 0, t1: Infinity, c }]);
          c.keys = [key];
          site.stack.push(c);
          placed++;
        }
      }
    }

    function dispatch(t: Tier): void {
      /* Recycle sites that have emptied out, so the composition's layout
         keeps evolving instead of rebuilding the same skyline. */
      const cols = columnKeys(t);
      for (let i = 0; i < t.sites.length; i++) {
        const s = t.sites[i]!;
        if (s.stack.length === 0 && rand() < 0.06) {
          cols.delete(`${s.gx},${s.gy}`);
          const next = newSite(t, cols);
          if (next) t.sites[i] = next;
        }
      }
      if (flightsOf(t) >= t.flightCap) return;
      const ready = t.cubes.filter((c) => c.state === WAITING && c.dwell <= 0);
      if (ready.length === 0) return;
      const open = t.sites.filter((s) => s.stack.length < s.cap);
      if (open.length === 0) return;
      const cube = pick(ready);
      const site = pick(open);
      if (planInbound(t, cube, site, site.stack.length)) site.stack.push(cube);
      else cube.dwell = 1 + rand() * 3;
    }

    function update(dt: number): void {
      const sdt = dt * cfg.speed;
      simT += sdt;
      orbT += sdt;
      for (const t of tiers) {
        t.pruneT -= sdt;
        if (t.pruneT <= 0) {
          prune(t);
          t.pruneT = 4;
        }
        t.schedT -= sdt;
        if (t.schedT <= 0) {
          dispatch(t);
          t.schedT = 0.7 + rand() * 1.1;
        }
        for (const c of t.cubes) {
          if (c.state === PARKED) {
            c.dwell -= sdt;
            if (c.dwell <= 0) {
              /* Towers only ever release their top cube, so nothing is
                 left hanging in mid-air. */
              const top = c.site?.stack.at(-1) === c;
              if (top && flightsOf(t) < t.flightCap && planOutbound(t, c)) {
                if (c.site) c.site.stack.pop();
                c.site = null;
              } else {
                c.dwell = 3 + rand() * 8;
              }
            }
          } else if (c.state === WAITING) {
            c.dwell -= sdt;
          } else {
            const k = (simT - c.startT) / c.dur;
            if (k >= 1) {
              finishTrip(t, c);
            } else {
              const p = posAt(c.path!, c.segLen, c.ease(k) * c.total);
              c.px = p.x;
              c.py = p.y;
              c.pz = p.z;
            }
          }
        }
      }
    }

    /* ---------- Render ---------- */

    function render(): void {
      for (const t of tiers) {
        const { ctx, scale, sprite } = t;
        const S = t.cfg.size;
        /* Painter's algorithm on iso axes: footprint depth first, then
           height — stacked and overlapping cubes occlude correctly. */
        t.cubes.sort((a, b) => a.px + a.py - (b.px + b.py) || a.pz - b.pz);
        const obX = Math.cos((orbT * 2 * Math.PI) / 70) * 16 * t.cfg.parallax;
        const obY = Math.sin((orbT * 2 * Math.PI) / 70) * 9 * t.cfg.parallax;
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, t.canvas.width, t.canvas.height);
        ctx.setTransform(scale, 0, 0, scale, 0, 0);
        ctx.fillStyle = '#000'; // punch fills: only alpha matters
        const cull = S * 2.2;
        for (const c of t.cubes) {
          if (!c.active) continue;
          const sx = toScreenX(t, c.px, c.py) + obX;
          const sy = toScreenY(t, c.px, c.py, c.pz) + obY;
          if (sx < -cull || sx > W + cull || sy < -cull || sy > H + cull + S * 2) continue;
          ctx.globalCompositeOperation = 'destination-out';
          hexPath(ctx, sx, sy, S);
          ctx.fill();
          ctx.globalCompositeOperation = 'source-over';
          ctx.drawImage(sprite.canvas, sx - sprite.ox, sy - sprite.oy, sprite.w, sprite.h);
        }
      }
      if (!revealed) {
        revealed = true;
        tiers.forEach((t, i) => {
          canvases[i]!.style.opacity = String(t.cfg.opacity);
        });
        if (grainEl && cfg.grain > 0) grainEl.style.opacity = (cfg.grain * 0.35).toFixed(3);
      }
    }

    function build(): void {
      W = container.clientWidth || innerWidth;
      H = container.clientHeight || innerHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      /* Density scales with viewport area, hard-capped for perf. */
      const total = clamp(Math.round(70 * cfg.density * ((W * H) / (1440 * 900))), 24, 110);
      tiers = TIERS.map((tc, i) => {
        const canvas = canvases[i]!;
        const scale = dpr * tc.res;
        canvas.width = Math.max(1, Math.ceil(W * scale));
        canvas.height = Math.max(1, Math.ceil(H * scale));
        const ctx = canvas.getContext('2d')!;
        const tier: Tier = {
          cfg: tc,
          canvas,
          ctx,
          scale,
          sprite: makeSprite(tc.size, scale, palette, tc.flatten),
          cubes: [],
          sites: [],
          res: new Map(),
          flightCap: 2,
          schedT: rand() * 1.5,
          pruneT: 4,
        };
        populate(tier, Math.round(total * tc.share));
        return tier;
      });
      /* Test hook: lets integration checks assert the no-overlap invariant. */
      (container as HTMLElement & { _tiers?: Tier[] })._tiers = tiers;
    }

    function rebuildSprites(): void {
      for (const t of tiers) t.sprite = makeSprite(t.cfg.size, t.scale, palette, t.cfg.flatten);
    }

    function buildGrain(): void {
      if (!grainEl) return;
      if (cfg.grain <= 0) {
        grainEl.style.display = 'none';
        return;
      }
      const g = document.createElement('canvas');
      g.width = g.height = 128;
      const gctx = g.getContext('2d');
      if (!gctx) return;
      const img = gctx.createImageData(128, 128);
      for (let i = 0; i < img.data.length; i += 4) {
        img.data[i] = palette.r;
        img.data[i + 1] = palette.g;
        img.data[i + 2] = palette.b;
        img.data[i + 3] = rand() < 0.5 ? 0 : rand() * 46;
      }
      gctx.putImageData(img, 0, 0);
      grainEl.style.backgroundImage = `url(${g.toDataURL()})`;
    }

    /* ---------- Lifecycle ---------- */

    const html = document.documentElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    /* The site's motion toggle already folds in the OS preference and lets
       the user override it; fall back to the raw media query when the
       component is mounted somewhere without that system. */
    const animEnabled = () =>
      html.dataset.motion ? html.dataset.motion === 'on' : !reduced.matches;

    const frame = (ts: number) => {
      raf = requestAnimationFrame(frame);
      const dt = clamp((ts - last) / 1000, 0, 0.05);
      last = ts;
      update(dt);
      render();
    };

    function sync(): void {
      const should = animEnabled() && !document.hidden && intersecting;
      if (should && raf === 0) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      } else if (!should && raf !== 0) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ['data-motion'] });
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver((entries) => {
      intersecting = entries[entries.length - 1]?.isIntersecting ?? true;
      sync();
    }).observe(container);

    let resizeT = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = window.setTimeout(() => {
        build();
        render();
      }, 180);
    });

    /* Theme flips change the resolved base color — re-read it after the
       new styles apply, then re-bake sprites and grain. */
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      requestAnimationFrame(() => {
        palette = computePalette(container);
        rebuildSprites();
        buildGrain();
        render();
      });
    });

    buildGrain();
    build();
    render(); // static composition is the floor; animation is enhancement
    sync();
  }

  for (const el of document.querySelectorAll<HTMLElement>('[data-iso-cubes]')) setup(el);
</script>

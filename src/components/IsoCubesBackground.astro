---
/**
 * IsoCubesBackground — ambient, autonomous isometric-cube field.
 *
 * A fixed, full-viewport Canvas 2D layer behind all content (z-index -1,
 * pointer-events none, aria-hidden). Cubes glide cell-by-cell along the
 * isometric lattice axes, assemble into small towers around a
 * configurable focal point, and disperse again; the whole field sways on
 * a slow orbit. Three canvas tiers give the depth: far tiers are smaller,
 * fainter, lower-resolution, and softened by *static* CSS blurs — the
 * compositor pays for depth-of-field once, never per cube.
 *
 * Movement is collision-proof by construction: each cube occupies one
 * integer grid cell, and every move first reserves its destination cell,
 * holding both cells until the glide completes. Claims are exclusive and
 * an axis-aligned step never leaves its two claimed cells, so cubes in a
 * tier can touch faces but can never pass through one another — they
 * route around towers and each other instead.
 *
 * Every pixel derives from `baseColor` (default: the theme ink via
 * currentColor). Face shades, edges, and grain are alpha steps of that one
 * color; light/dark polarity is read from the page background so the top
 * face always renders lightest, on either theme.
 *
 * Honors the site's `data-motion` toggle where present (falling back to
 * `prefers-reduced-motion` alone) — motion off renders a single static,
 * fully-assembled composition. Pauses when the tab is hidden or the
 * element leaves the viewport.
 *
 * Mount once, first thing inside <body> (see Base.astro):
 *
 *   <IsoCubesBackground />
 *
 * or tuned:
 *
 *   <IsoCubesBackground intensity={0.7} focal={{ x: 0.5, y: 0.5 }} />
 */
interface Props {
  /** Any CSS color; the entire field derives from it. Default: theme ink. */
  baseColor?: string;
  /** 0..1 — overall visual strength (the field's opacity ceiling). */
  intensity?: number;
  /** Cube-count multiplier: 1 ≈ 70 cubes on a 1440×900 viewport, hard-capped. */
  density?: number;
  /** Focal point the field clusters around, as viewport fractions. */
  focal?: { x: number; y: number };
  /** Cluster tightness — falloff radius as a fraction of min(vw, vh). */
  focalRadius?: number;
  /** 0..1 — how strongly movement is biased toward the focal point vs roaming. */
  focalPull?: number;
  /** Global speed multiplier for every motion. */
  speed?: number;
  /** 0..1 — faint film-grain strength (0 disables). */
  grain?: number;
}

const {
  baseColor = 'var(--bg-accent, currentColor)',
  intensity = 0.5,
  density = 1,
  focal = { x: 0.7, y: 0.36 },
  focalRadius = 0.42,
  focalPull = 0.6,
  speed = 1,
  grain = 0.5,
} = Astro.props;

const config = { density, focal, focalRadius, focalPull, speed, grain };
---

<div
  class="iso-cubes"
  aria-hidden="true"
  data-iso-cubes={JSON.stringify(config)}
  style={`color:${baseColor};opacity:${(0.36 * intensity).toFixed(3)};--fx:${(focal.x * 100).toFixed(1)}%;--fy:${(focal.y * 100).toFixed(1)}%;`}
>
  <canvas data-tier="0"></canvas>
  <canvas data-tier="1"></canvas>
  <canvas data-tier="2"></canvas>
  <div class="iso-grain"></div>
</div>

<style>
  .iso-cubes {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
    /* Atmospheric falloff: the field breathes around the focal point and
       thins toward the viewport edges instead of ending at a hard frame. */
    -webkit-mask-image: radial-gradient(
      140% 125% at var(--fx) var(--fy),
      #000 28%,
      rgb(0 0 0 / 0.6) 68%,
      rgb(0 0 0 / 0.25) 100%
    );
    mask-image: radial-gradient(
      140% 125% at var(--fx) var(--fy),
      #000 28%,
      rgb(0 0 0 / 0.6) 68%,
      rgb(0 0 0 / 0.25) 100%
    );
  }

  .iso-cubes canvas,
  .iso-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0; /* revealed by script after the first frame */
    transition: opacity 700ms ease;
  }

  /* Depth of field as static compositor filters — no per-cube canvas blur.
     Far tiers also render at reduced backing resolution (see TIERS). */
  canvas[data-tier='0'] {
    filter: blur(2.1px);
  }
  canvas[data-tier='1'] {
    filter: blur(0.7px);
  }

  .iso-grain {
    background-repeat: repeat;
  }

  @media (prefers-reduced-motion: reduce) {
    .iso-cubes canvas,
    .iso-grain {
      transition: none;
    }
  }
</style>

<script>
  /* True isometric axes (30°): every cube shares them — no per-cube
     rotation. A cube is one pre-rendered sprite per tier, stamped many
     times per frame. */
  const ISO_X = Math.cos(Math.PI / 6);
  const ISO_Y = Math.sin(Math.PI / 6);

  /* Depth tiers, far → near. Blur and tier opacity live in CSS; `res`
     drops far-tier backing resolution (blurred anyway), `flatten`
     compresses face contrast with distance, `spread` widens the far
     cluster so the parallax reads as one deep field, and `parallax`
     scales the shared orbit — near sways more than far. */
  const TIERS = [
    { size: 13, share: 0.42, opacity: 0.5, parallax: 0.35, res: 0.6, speed: 0.55, flatten: 0.45, spread: 1.3 },
    { size: 21, share: 0.34, opacity: 0.75, parallax: 0.65, res: 0.85, speed: 0.8, flatten: 0.2, spread: 1.05 },
    { size: 33, share: 0.24, opacity: 1, parallax: 1, res: 1, speed: 1, flatten: 0, spread: 0.82 },
  ];

  const FLOAT = 0;
  const SEEK = 1;
  const LOCKED = 2;

  /* Roaming cubes travel at levels 0..MAX_Z; towers top out below it. */
  const MAX_Z = 4;

  interface Config {
    density: number;
    focal: { x: number; y: number };
    focalRadius: number;
    focalPull: number;
    speed: number;
    grain: number;
  }

  interface Cube {
    state: number;
    x: number;
    y: number;
    z: number; // occupied cell (integer lattice)
    tx: number;
    ty: number;
    tz: number; // reserved destination cell (== x,y,z when idle)
    px: number;
    py: number;
    pz: number; // interpolated position, refreshed each render
    moving: boolean;
    moveT: number;
    moveDur: number;
    pause: number; // time until the next step attempt
    run: number; // chained steps left in the current direction
    runDX: number;
    runDY: number;
    travelZ: number; // seek cruise altitude (≥ landing level + 1)
    homeX: number;
    homeY: number;
    homeT: number;
    env: number; // fade envelope, avoids pop on relocation
    fading: boolean;
    site: Site | null;
    level: number;
    timer: number;
    blocked: number; // consecutive denied steps while seeking
  }

  interface Site {
    gx: number;
    gy: number;
    cap: number;
    stack: Cube[];
  }

  interface Sprite {
    canvas: HTMLCanvasElement;
    w: number;
    h: number;
    ox: number;
    oy: number;
  }

  interface Tier {
    cfg: (typeof TIERS)[number];
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    scale: number;
    sprite: Sprite;
    cubes: Cube[];
    sites: Site[];
    cells: Map<string, Cube>; // occupancy: every claimed cell, incl. move targets
    schedT: number;
  }

  interface Palette {
    r: number;
    g: number;
    b: number;
    a: number;
    faces: { top: number; left: number; right: number };
    edge: number;
  }

  const rand = Math.random;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  /* Box–Muller; 1-rand() keeps log() off zero */
  const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  /* Normalize any CSS color through a 1×1 canvas — handles rgb(), lab(),
     color-mix() results, keywords, everything getComputedStyle can emit. */
  const probe = document.createElement('canvas');
  probe.width = probe.height = 1;
  const probeCtx = probe.getContext('2d', { willReadFrequently: true });

  function parseColor(str: string): [number, number, number, number] {
    if (!probeCtx) return [128, 128, 128, 1];
    probeCtx.clearRect(0, 0, 1, 1);
    probeCtx.fillStyle = '#000';
    probeCtx.fillStyle = str;
    probeCtx.fillRect(0, 0, 1, 1);
    const d = probeCtx.getImageData(0, 0, 1, 1).data;
    return [d[0]!, d[1]!, d[2]!, d[3]! / 255];
  }

  const luminance = (c: [number, number, number, number]) =>
    0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];

  function resolveBackground(): [number, number, number, number] {
    for (const el of [document.body, document.documentElement]) {
      const c = parseColor(getComputedStyle(el).backgroundColor);
      if (c[3] > 0.02) return c;
    }
    return matchMedia('(prefers-color-scheme: dark)').matches
      ? [0, 0, 0, 1]
      : [255, 255, 255, 1];
  }

  function computePalette(el: HTMLElement): Palette {
    const base = parseColor(getComputedStyle(el).color);
    const lightInk = luminance(base) > luminance(resolveBackground());
    /* The top face must read lightest against the page: with a light ink
       on a dark page that means the most ink (highest alpha); with a dark
       ink on a light page, the least. Left stays brighter than right —
       one consistent light source from the upper left. */
    const faces = lightInk
      ? { top: 0.92, left: 0.5, right: 0.3 }
      : { top: 0.26, left: 0.5, right: 0.78 };
    return { r: base[0], g: base[1], b: base[2], a: base[3], faces, edge: 0.85 };
  }

  function shade(pal: Palette, alpha: number): string {
    return `rgba(${pal.r},${pal.g},${pal.b},${(alpha * pal.a).toFixed(3)})`;
  }

  /* One cube, three faces + hairline edges, baked once per tier. `flatten`
     pulls the face alphas toward their mean — distant cubes lose contrast
     the way real atmosphere takes it. */
  function makeSprite(S: number, scale: number, pal: Palette, flatten: number): Sprite {
    const X = ISO_X * S;
    const Y = ISO_Y * S;
    const pad = 2;
    const w = 2 * X + pad * 2;
    const h = 2 * S + pad * 2;
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.ceil(w * scale));
    canvas.height = Math.max(1, Math.ceil(h * scale));
    const ctx = canvas.getContext('2d');
    const ox = pad + X;
    const oy = h - pad;
    if (!ctx) return { canvas, w, h, ox, oy };
    ctx.scale(scale, scale);
    ctx.translate(ox, oy); // origin = bottom-front vertex
    const mean = (pal.faces.top + pal.faces.left + pal.faces.right) / 3;
    const soften = (a: number) => a + (mean - a) * flatten;
    ctx.lineWidth = 1;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = shade(pal, pal.edge * (1 - flatten * 0.7));
    const face = (pts: [number, number][], alpha: number) => {
      ctx.beginPath();
      ctx.moveTo(pts[0]![0], pts[0]![1]);
      for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i]![0], pts[i]![1]);
      ctx.closePath();
      ctx.fillStyle = shade(pal, soften(alpha));
      ctx.fill();
      ctx.stroke();
    };
    face([[0, -S], [X, -Y - S], [0, -2 * Y - S], [-X, -Y - S]], pal.faces.top);
    face([[0, 0], [-X, -Y], [-X, -Y - S], [0, -S]], pal.faces.left);
    face([[0, 0], [X, -Y], [X, -Y - S], [0, -S]], pal.faces.right);
    return { canvas, w, h, ox, oy };
  }

  /* Cube silhouette (hexagon), used to punch a hole before stamping the
     translucent sprite: back cubes never bleed through front ones, which
     is what makes the painter's-algorithm stacking actually read. */
  function hexPath(ctx: CanvasRenderingContext2D, x: number, y: number, S: number): void {
    const X = ISO_X * S;
    const Y = ISO_Y * S;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + X, y - Y);
    ctx.lineTo(x + X, y - Y - S);
    ctx.lineTo(x, y - 2 * Y - S);
    ctx.lineTo(x - X, y - Y - S);
    ctx.lineTo(x - X, y - Y);
    ctx.closePath();
  }

  function setup(container: HTMLElement): void {
    const cfg: Config = {
      density: 1,
      focal: { x: 0.7, y: 0.36 },
      focalRadius: 0.42,
      focalPull: 0.6,
      speed: 1,
      grain: 0.5,
      ...(JSON.parse(container.dataset.isoCubes || '{}') as Partial<Config>),
    };
    const canvases = Array.from(container.querySelectorAll('canvas'));
    const grainEl = container.querySelector<HTMLElement>('.iso-grain');
    if (canvases.length < TIERS.length) return;

    let W = 0;
    let H = 0;
    let palette: Palette = computePalette(container);
    let tiers: Tier[] = [];
    let orbT = rand() * 70; // start mid-orbit: nothing to sync a loop point to
    let raf = 0;
    let last = 0;
    let intersecting = true;
    let revealed = false;

    /* World mapping: screen = center + iso(world), so world coords survive
       gentle resizes and the orbit is a pure render-time offset. */
    const toScreenX = (t: Tier, gx: number, gy: number) => W / 2 + (gx - gy) * ISO_X * t.cfg.size;
    const toScreenY = (t: Tier, gx: number, gy: number, gz: number) =>
      H / 2 + (gx + gy) * ISO_Y * t.cfg.size - gz * t.cfg.size;
    const toWorld = (t: Tier, px: number, py: number) => {
      const u = (px - W / 2) / (ISO_X * t.cfg.size);
      const v = (py - H / 2) / (ISO_Y * t.cfg.size);
      return { gx: (v + u) / 2, gy: (v - u) / 2 };
    };

    /* Gaussian sample around the focal point — the density falloff. σ is
       half the falloff radius, so ~95% of the field sits inside it. */
    const sampleHome = (t: Tier, tighten = 1) => {
      const R = cfg.focalRadius * Math.min(W, H) * 0.5 * t.cfg.spread * tighten;
      return toWorld(
        t,
        cfg.focal.x * W + gauss() * R,
        cfg.focal.y * H + gauss() * R * 0.8
      );
    };

    const cellKey = (x: number, y: number, z: number) => `${x},${y},${z}`;

    function makeCube(home: { gx: number; gy: number }, x: number, y: number, z: number): Cube {
      return {
        state: FLOAT,
        x,
        y,
        z,
        tx: x,
        ty: y,
        tz: z,
        px: x,
        py: y,
        pz: z,
        moving: false,
        moveT: 0,
        moveDur: 0.7,
        pause: rand() * 2.5,
        run: 0,
        runDX: 0,
        runDY: 0,
        travelZ: 0,
        homeX: home.gx,
        homeY: home.gy,
        homeT: 14 + rand() * 24,
        env: 1,
        fading: false,
        site: null,
        level: 0,
        timer: 0,
        blocked: 0,
      };
    }

    function populate(t: Tier, count: number): void {
      t.cubes = [];
      t.sites = [];
      t.cells = new Map();
      const taken = new Set<string>();
      const nSites = Math.max(2, Math.round((count * 0.5) / 2.6));
      for (let i = 0; i < nSites * 8 && t.sites.length < nSites; i++) {
        const p = sampleHome(t, 0.8);
        const gx = Math.round(p.gx);
        const gy = Math.round(p.gy);
        const key = `${gx},${gy}`;
        if (taken.has(key)) continue;
        taken.add(key);
        t.sites.push({ gx, gy, cap: 2 + Math.floor(rand() * 3), stack: [] });
      }
      /* Start partially assembled: reduced-motion sees a finished
         composition, and the animated start has towers to unbuild. */
      for (const site of t.sites) {
        const fill = Math.min(count - t.cubes.length, Math.floor(site.cap * (0.35 + rand() * 0.45)));
        for (let lv = 0; lv < fill; lv++) {
          const cube = makeCube({ gx: site.gx, gy: site.gy }, site.gx, site.gy, lv);
          cube.state = LOCKED;
          cube.site = site;
          cube.level = lv;
          cube.timer = 6 + rand() * 18;
          site.stack.push(cube);
          t.cubes.push(cube);
          t.cells.set(cellKey(site.gx, site.gy, lv), cube);
        }
      }
      let guard = count * 40;
      while (t.cubes.length < count && guard-- > 0) {
        const home = sampleHome(t);
        const x = Math.round(home.gx + (rand() - 0.5) * 3);
        const y = Math.round(home.gy + (rand() - 0.5) * 3);
        const z = Math.floor(rand() * MAX_Z);
        if (t.cells.has(cellKey(x, y, z))) continue;
        const cube = makeCube(home, x, y, z);
        t.cells.set(cellKey(x, y, z), cube);
        t.cubes.push(cube);
      }
    }

    function build(): void {
      W = container.clientWidth || innerWidth;
      H = container.clientHeight || innerHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      /* Density scales with viewport area, hard-capped for perf. */
      const total = clamp(Math.round(70 * cfg.density * ((W * H) / (1440 * 900))), 24, 110);
      tiers = TIERS.map((tc, i) => {
        const canvas = canvases[i]!;
        const scale = dpr * tc.res;
        canvas.width = Math.max(1, Math.ceil(W * scale));
        canvas.height = Math.max(1, Math.ceil(H * scale));
        const ctx = canvas.getContext('2d')!;
        const tier: Tier = {
          cfg: tc,
          canvas,
          ctx,
          scale,
          sprite: makeSprite(tc.size, scale, palette, tc.flatten),
          cubes: [],
          sites: [],
          cells: new Map(),
          schedT: rand() * 2,
        };
        populate(tier, Math.round(total * tc.share));
        return tier;
      });
      /* Test hook: lets integration checks assert the no-overlap invariant. */
      (container as HTMLElement & { _tiers?: Tier[] })._tiers = tiers;
    }

    function rebuildSprites(): void {
      for (const t of tiers) t.sprite = makeSprite(t.cfg.size, t.scale, palette, t.cfg.flatten);
    }

    function buildGrain(): void {
      if (!grainEl) return;
      if (cfg.grain <= 0) {
        grainEl.style.display = 'none';
        return;
      }
      const g = document.createElement('canvas');
      g.width = g.height = 128;
      const gctx = g.getContext('2d');
      if (!gctx) return;
      const img = gctx.createImageData(128, 128);
      for (let i = 0; i < img.data.length; i += 4) {
        img.data[i] = palette.r;
        img.data[i + 1] = palette.g;
        img.data[i + 2] = palette.b;
        img.data[i + 3] = rand() < 0.5 ? 0 : rand() * 46;
      }
      gctx.putImageData(img, 0, 0);
      grainEl.style.backgroundImage = `url(${g.toDataURL()})`;
    }

    /* ---------- Simulation: axis-aligned steps on an exclusive grid ----------

       A cube always owns the cell it stands in. beginStep() additionally
       claims the destination cell and keeps both until arrive() releases
       the origin — so any two cubes' claims are disjoint, and since an
       axis step's swept volume is exactly its two claimed cells, cubes can
       touch faces but can never intersect. A denied claim just means
       "blocked": floats pick another direction, seekers wait or reroute. */

    function beginStep(t: Tier, c: Cube, dx: number, dy: number, dz: number): boolean {
      const nx = c.x + dx;
      const ny = c.y + dy;
      const nz = c.z + dz;
      if (nz < 0 || nz > MAX_Z) return false;
      const key = cellKey(nx, ny, nz);
      if (t.cells.has(key)) return false;
      t.cells.set(key, c);
      c.tx = nx;
      c.ty = ny;
      c.tz = nz;
      c.moving = true;
      c.moveT = 0;
      c.moveDur = 0.55 + rand() * 0.35;
      return true;
    }

    function arrive(t: Tier, c: Cube): void {
      t.cells.delete(cellKey(c.x, c.y, c.z));
      c.x = c.tx;
      c.y = c.ty;
      c.z = c.tz;
      c.moving = false;
      c.moveT = 0;
      if (c.state === SEEK && c.site && c.x === c.site.gx && c.y === c.site.gy && c.z === c.level) {
        c.state = LOCKED;
        c.timer = 9 + rand() * 16;
        c.blocked = 0;
        return;
      }
      c.pause = c.state === SEEK ? 0.15 + rand() * 0.3 : c.run > 0 ? 0.05 : 1.2 + rand() * 3;
    }

    /* Roaming: single eased steps with pauses, occasionally chained into
       short straight runs, direction-weighted toward the cube's personal
       home near the focal point. focalPull sets the weighting sharpness;
       the home is never the focal point itself, so density stays a smooth
       falloff instead of a clump. */
    function floatAttempt(t: Tier, c: Cube): void {
      if (c.run > 0) {
        if (beginStep(t, c, c.runDX, c.runDY, 0)) {
          c.run--;
          return;
        }
        c.run = 0;
      }
      if (rand() < 0.16 && beginStep(t, c, 0, 0, rand() < 0.5 ? 1 : -1)) return;
      const hx = c.homeX - c.x;
      const hy = c.homeY - c.y;
      const m = Math.hypot(hx, hy) || 1;
      const bias = 2.2 * cfg.focalPull;
      const dirs: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];
      const weights = dirs.map(([dx, dy]) => Math.exp(((dx * hx + dy * hy) / m) * bias));
      for (let n = 0; n < 4; n++) {
        let total = 0;
        for (const w of weights) total += w;
        if (total <= 0) break;
        let r = rand() * total;
        let i = 0;
        while (i < 3 && (r -= weights[i]!) > 0) i++;
        const d = dirs[i]!;
        if (beginStep(t, c, d[0], d[1], 0)) {
          if (rand() < 0.5) {
            c.run = 1 + Math.floor(rand() * 2);
            c.runDX = d[0];
            c.runDY = d[1];
          }
          return;
        }
        weights[i] = 0; // that way is blocked — reweigh the rest
      }
      c.pause = 0.4 + rand() * 0.8; // boxed in; try again shortly
    }

    /* Assembly: rise to cruise altitude (above the landing level), travel
       the lattice to the tower column, then descend onto the stack top.
       Blocked steps wait, climb, or sidestep; too many in a row abandons
       the errand and returns the cube to roaming. */
    function seekAttempt(t: Tier, c: Cube): void {
      const site = c.site;
      if (!site) {
        c.state = FLOAT;
        return;
      }
      let ok = false;
      if (c.x === site.gx && c.y === site.gy) {
        ok = c.z > c.level && beginStep(t, c, 0, 0, -1);
      } else if (c.z < c.travelZ) {
        ok = beginStep(t, c, 0, 0, 1);
      } else {
        const dx = Math.sign(site.gx - c.x);
        const dy = Math.sign(site.gy - c.y);
        const tries: [number, number][] =
          Math.abs(site.gx - c.x) >= Math.abs(site.gy - c.y)
            ? [[dx, 0], [0, dy]]
            : [[0, dy], [dx, 0]];
        for (const [mx, my] of tries) {
          if ((mx !== 0 || my !== 0) && beginStep(t, c, mx, my, 0)) {
            ok = true;
            break;
          }
        }
        if (!ok && c.z < MAX_Z && rand() < 0.5) ok = beginStep(t, c, 0, 0, 1); // climb over
        if (!ok) {
          const d = dirs4[Math.floor(rand() * 4)]!;
          ok = beginStep(t, c, d[0], d[1], 0); // sidestep around
        }
      }
      if (ok) {
        c.blocked = 0;
        return;
      }
      c.blocked++;
      c.pause = 0.25 + rand() * 0.4;
      if (c.blocked > 10) abortSeek(c);
    }

    const dirs4: [number, number][] = [[1, 0], [-1, 0], [0, 1], [0, -1]];

    function abortSeek(c: Cube): void {
      if (c.site && c.site.stack.at(-1) === c) c.site.stack.pop();
      c.site = null;
      c.state = FLOAT;
      c.homeT = 0;
      c.blocked = 0;
      c.run = 0;
    }

    function release(c: Cube): void {
      c.site?.stack.pop();
      c.site = null;
      c.state = FLOAT;
      c.homeT = 0; // pick a fresh destination — the step engine walks it away
      c.pause = 0.4 + rand() * 0.8;
      c.run = 0;
    }

    function tryAssign(t: Tier): void {
      const floats = t.cubes.filter((c) => c.state === FLOAT && !c.fading && c.env > 0.6);
      /* Keep a live population of roamers — the field should never fully
         crystallize into towers. */
      if (floats.length <= t.cubes.length * 0.3) return;
      /* One in-flight seeker per site keeps every descent column clear of
         other seekers, and the landing cell must be free right now —
         together with release-from-top-only this can't deadlock. */
      const open = t.sites.filter(
        (s) =>
          s.stack.length < s.cap &&
          !s.stack.some((c) => c.state !== LOCKED) &&
          !t.cells.has(cellKey(s.gx, s.gy, s.stack.length))
      );
      if (open.length === 0) return;
      const site = open[Math.floor(rand() * open.length)]!;
      let best: Cube | null = null;
      let bd = Infinity;
      for (const f of floats) {
        const d = (f.tx - site.gx) ** 2 + (f.ty - site.gy) ** 2;
        if (d < bd) {
          bd = d;
          best = f;
        }
      }
      if (!best || bd > 26 * 26) return;
      best.state = SEEK;
      best.site = site;
      best.level = site.stack.length;
      best.travelZ = Math.max(best.tz, best.level + 1);
      best.blocked = 0;
      best.run = 0;
      site.stack.push(best);
      if (!best.moving) best.pause = Math.min(best.pause, 0.2 + rand() * 0.3);
    }

    function relocate(t: Tier, c: Cube): void {
      for (let i = 0; i < 20; i++) {
        const p = sampleHome(t);
        const x = Math.round(p.gx + (rand() - 0.5) * 3);
        const y = Math.round(p.gy + (rand() - 0.5) * 3);
        const z = Math.floor(rand() * MAX_Z);
        const key = cellKey(x, y, z);
        if (t.cells.has(key)) continue;
        t.cells.delete(cellKey(c.x, c.y, c.z));
        t.cells.set(key, c);
        c.x = c.tx = x;
        c.y = c.ty = y;
        c.z = c.tz = z;
        c.homeX = p.gx;
        c.homeY = p.gy;
        c.env = 0;
        c.fading = false;
        c.run = 0;
        c.pause = rand();
        return;
      }
      c.env = 0; // no free cell this frame — stay hidden, retry next
    }

    function update(dt: number): void {
      orbT += dt * cfg.speed;
      for (const t of tiers) {
        const sdt = dt * cfg.speed * t.cfg.speed;
        t.schedT -= sdt;
        if (t.schedT <= 0) {
          tryAssign(t);
          t.schedT = 1.8 + rand() * 2.4;
        }
        const margin = t.cfg.size * 3;
        for (const c of t.cubes) {
          if (c.moving) {
            c.moveT += sdt / c.moveDur;
            if (c.moveT >= 1) arrive(t, c);
          } else if (c.state === LOCKED) {
            c.timer -= sdt;
            if (c.timer <= 0) {
              /* Towers unbuild from the top only. */
              if (c.site && c.site.stack.at(-1) === c) release(c);
              else c.timer = 2 + rand() * 3;
            }
          } else {
            c.pause -= sdt;
            if (c.pause <= 0) {
              c.pause = 0.2;
              if (c.state === FLOAT) floatAttempt(t, c);
              else seekAttempt(t, c);
            }
          }
          if (c.state === FLOAT) {
            c.homeT -= sdt;
            if (c.homeT <= 0) {
              const p = sampleHome(t);
              c.homeX = p.gx;
              c.homeY = p.gy;
              c.homeT = 16 + rand() * 22;
            }
            if (!c.fading && !c.moving) {
              const sx = toScreenX(t, c.x, c.y);
              const sy = toScreenY(t, c.x, c.y, c.z);
              if (sx < -margin || sx > W + margin || sy < -margin || sy > H + margin) {
                c.fading = true;
              }
            }
          }
          if (c.fading) {
            c.env = Math.max(0, c.env - sdt * 0.7);
            if (c.env <= 0 && !c.moving) relocate(t, c);
          } else if (c.env < 1) {
            c.env = Math.min(1, c.env + sdt * 0.7);
          }
        }
      }
    }

    /* ---------- Render ---------- */

    function render(): void {
      for (const t of tiers) {
        const { ctx, scale, sprite } = t;
        const S = t.cfg.size;
        for (const c of t.cubes) {
          const e = c.moving ? easeInOut(Math.min(1, c.moveT)) : 0;
          c.px = c.x + (c.tx - c.x) * e;
          c.py = c.y + (c.ty - c.y) * e;
          c.pz = c.z + (c.tz - c.z) * e;
        }
        /* Painter's algorithm on iso axes: footprint depth first, then
           height — stacked and overlapping cubes occlude correctly. */
        t.cubes.sort((a, b) => a.px + a.py - (b.px + b.py) || a.pz - b.pz);
        const obX = Math.cos((orbT * 2 * Math.PI) / 70) * 16 * t.cfg.parallax;
        const obY = Math.sin((orbT * 2 * Math.PI) / 70) * 9 * t.cfg.parallax;
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, t.canvas.width, t.canvas.height);
        ctx.setTransform(scale, 0, 0, scale, 0, 0);
        ctx.fillStyle = '#000'; // punch fills: only alpha matters
        const cull = S * 2.2;
        for (const c of t.cubes) {
          if (c.env <= 0.01) continue;
          const sx = toScreenX(t, c.px, c.py) + obX;
          const sy = toScreenY(t, c.px, c.py, c.pz) + obY;
          if (sx < -cull || sx > W + cull || sy < -cull || sy > H + cull + S * 2) continue;
          ctx.globalAlpha = c.env;
          ctx.globalCompositeOperation = 'destination-out';
          hexPath(ctx, sx, sy, S);
          ctx.fill();
          ctx.globalCompositeOperation = 'source-over';
          ctx.drawImage(sprite.canvas, sx - sprite.ox, sy - sprite.oy, sprite.w, sprite.h);
        }
        ctx.globalAlpha = 1;
      }
      if (!revealed) {
        revealed = true;
        tiers.forEach((t, i) => {
          canvases[i]!.style.opacity = String(t.cfg.opacity);
        });
        if (grainEl && cfg.grain > 0) grainEl.style.opacity = (cfg.grain * 0.35).toFixed(3);
      }
    }

    /* ---------- Lifecycle ---------- */

    const html = document.documentElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    /* The site's motion toggle already folds in the OS preference and lets
       the user override it; fall back to the raw media query when the
       component is mounted somewhere without that system. */
    const animEnabled = () =>
      html.dataset.motion ? html.dataset.motion === 'on' : !reduced.matches;

    const frame = (ts: number) => {
      raf = requestAnimationFrame(frame);
      const dt = clamp((ts - last) / 1000, 0, 0.05);
      last = ts;
      update(dt);
      render();
    };

    function sync(): void {
      const should = animEnabled() && !document.hidden && intersecting;
      if (should && raf === 0) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      } else if (!should && raf !== 0) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ['data-motion'] });
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver((entries) => {
      intersecting = entries[entries.length - 1]?.isIntersecting ?? true;
      sync();
    }).observe(container);

    let resizeT = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = window.setTimeout(() => {
        build();
        render();
      }, 180);
    });

    /* Theme flips change the resolved base color — re-read it after the
       new styles apply, then re-bake sprites and grain. */
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      requestAnimationFrame(() => {
        palette = computePalette(container);
        rebuildSprites();
        buildGrain();
        render();
      });
    });

    buildGrain();
    build();
    render(); // static composition is the floor; animation is enhancement
    sync();
  }

  for (const el of document.querySelectorAll<HTMLElement>('[data-iso-cubes]')) setup(el);
</script>

---
import type { Venture } from '../data/site';
import GeeqoidWordmark from './GeeqoidWordmark.astro';

interface Props {
  item: Venture;
}

const { item } = Astro.props;
const links = item.links.filter((l) => l.url);

/** Brand wordmarks that stand in for the title text — see `Venture.logo` */
const LOGOS = { geeqoid: GeeqoidWordmark };
const Logo = item.logo ? LOGOS[item.logo] : null;
---

<li class="media-item" data-accent={item.slug}>
  <p class="kicker">{item.kicker}</p>
  {
    /* With a wordmark the heading keeps its text for AT and the outline,
       visually hidden behind the artwork */
    Logo ? (
      <h3 class="has-logo">
        <Logo />
        <span class="visually-hidden">{item.name}</span>
      </h3>
    ) : (
      <h3>{item.name}</h3>
    )
  }
  <p>{item.description}</p>
  {
    links.length > 0 && (
      <ul class="card-links">
        {links.map((link) => (
          <li>
            <a href={link.url}>{link.label}</a>
          </li>
        ))}
      </ul>
    )
  }
</li>

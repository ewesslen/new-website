---
import '@fontsource-variable/familjen-grotesk';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import { SITE, SOCIALS, NEWSLETTER } from '../data/site';
import SocialIcon from '../components/SocialIcon.astro';
import IsoCubesBackground from '../components/IsoCubesBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const year = new Date().getFullYear();
const socials = SOCIALS.filter((s) => s.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f7fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0d18" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      /* Absolute URLs require `site` in astro.config.mjs — set it and these
         light up; until then no broken relative URLs are emitted. */
      Astro.site && (
        <>
          <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
          <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
          <meta property="og:image" content={new URL('/og.png', Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${SITE.firstName} — ${SITE.tagline}`} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
        </>
      )
    }
    <script is:inline>
      // Pre-paint motion state: explicit choice (localStorage) wins, else OS.
      // `motion-pending` pre-hides reveal targets, with a failsafe timeout so
      // content can never stay hidden if the motion module fails to load.
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('motion');
        } catch {}
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const on = stored ? stored === 'on' : !reduced;
        d.dataset.motion = on ? 'on' : 'off';
        if (on) {
          d.classList.add('motion-pending');
          setTimeout(() => d.classList.remove('motion-pending'), 1600);
        }
      })();
    </script>
  </head>
  <body>
    <IsoCubesBackground />

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">{SITE.firstName} {SITE.lastName}</a>
        <div class="site-header-tools">
          <nav class="site-nav" aria-label="Site">
            <ul>
              <li><a href="/#building">Building</a></li>
              <li><a href="/#media">Media</a></li>
              <li><a href="/#writing">Writing</a></li>
              <li><a href="/#now">Now</a></li>
            </ul>
          </nav>
          <button class="motion-toggle" type="button" data-motion-toggle data-magnetic aria-pressed="false">
            <span class="motion-toggle-dot" aria-hidden="true"></span>
            Motion
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="subscribe">
          {
            NEWSLETTER.formAction ? (
              <form method="post" action={NEWSLETTER.formAction}>
                <label class="subscribe-label" for="subscribe-email">
                  Get {NEWSLETTER.name} in your inbox
                </label>
                <div class="subscribe-row">
                  <input
                    type="email"
                    id="subscribe-email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="you@example.com"
                  />
                  <button type="submit">Subscribe</button>
                </div>
              </form>
            ) : NEWSLETTER.subscribeUrl ? (
              <p>
                <a href={NEWSLETTER.subscribeUrl}>Subscribe to {NEWSLETTER.name}</a>
              </p>
            ) : (
              <p>Newsletter signup coming soon.</p>
            )
          }
        </div>

        <div class="footer-meta">
          <p>© {year} {SITE.firstName} {SITE.lastName}</p>
          {
            socials.length > 0 && (
              <nav class="social-nav" aria-label="Social">
                <ul>
                  {socials.map((s) => (
                    <li>
                      <a href={s.url} rel="me noopener" data-magnetic>
                        <SocialIcon platform={s.platform} />
                        <span class="visually-hidden">{s.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
